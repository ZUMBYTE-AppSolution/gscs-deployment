    {
      "name": "Game.ini File Download",
      "type": "file",
      "phase": "install",
      "platform": "all",
      "source": "[/Script/BeastsOfBermuda.ServerGameInstance]\nMapNameOverride=\"Forest_Island\"\nGameMode=Free_Roam\nDiscordLink=\"\"",
