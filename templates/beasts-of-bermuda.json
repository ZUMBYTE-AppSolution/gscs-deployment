      "arguments": "Game.ini",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Set Executable Flag",
      "type": "executable",
      "phase": "install",
      "platform": "linux",
      "source": "",
      "target": "LinuxServer/BeastsOfBermuda/Binaries/Linux/BeastsOfBermudaServer",
      "arguments": "{SERVER_DIR}/LinuxServer/BeastsOfBermuda/Binaries/Linux/BeastsOfBermudaServer",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Link Linux Saved Data To Windows",
      "type": "command",
      "phase": "start",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"B=\\\"{SERVER_DIR}/\\\"; link_saved() { mkdir -p \\\"$1\\\" \\\"$(dirname \\\"$2\\\")\\\" || exit 1; if [ -d \\\"$2\\\" ] && [ ! -L \\\"$2\\\" ]; then cp -an \\\"$2\\\"/. \\\"$1\\\"/ && mv \\\"$2\\\" \\\"$2.linux-backup-$(date -Iseconds)\\\" || exit 1; fi; ln -sfn \\\"$3\\\" \\\"$2\\\" || exit 1; }; link_saved \\\"${B}WindowsServer/BeastsOfBermuda/Saved/Config/WindowsServer\\\" \\\"${B}LinuxServer/BeastsOfBermuda/Saved/Config/LinuxServer\\\" \\\"../../../../WindowsServer/BeastsOfBermuda/Saved/Config/WindowsServer\\\"; link_saved \\\"${B}WindowsServer/BeastsOfBermuda/Saved/SaveGames\\\" \\\"${B}LinuxServer/BeastsOfBermuda/Saved/SaveGames\\\" \\\"../../../WindowsServer/BeastsOfBermuda/Saved/SaveGames\\\"; link_saved \\\"${B}WindowsServer/BeastsOfBermuda/Saved/User\\\" \\\"${B}LinuxServer/BeastsOfBermuda/Saved/User\\\" \\\"../../../WindowsServer/BeastsOfBermuda/Saved/User\\\"; echo \\\"Linked LinuxServer Config, SaveGames, and User to WindowsServer\\\"\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    }
  ],
