    {
      "role": "peer",
      "default": 7778,
      "protocol": "udp",
      "containerPort": 7778,
      "offsetFromRole": "game",
      "offset": 1
    },
    {
      "role": "query",
      "default": 27015,
      "protocol": "udp",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "MAP": "TheIsland_WP"
  },
