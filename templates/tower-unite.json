      "description": "Sets the maximum number of players allowed on the server at one time",
      "tab": "server",
      "section": "Server",
      "type": "number",
      "default": "32",
      "placeholder": "32",
      "required": false,
      "secret": false,
      "hidden": false,
      "readOnly": true,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {},
      "trueValue": "true",
      "falseValue": "false",
      "parameter": "/Script/TowerNetworking.DedicatedServerOptions.MaxPlayers",
      "parameterFormat": "-{0}=\"{1}\"",
      "includeInArguments": false,
      "isFlag": false,
      "skipIfEmpty": true,
      "min": 2.0,
      "max": 64.0
    },
    {
      "id": "CONDOAUTOSAVE",
      "label": "Enable Auto Save",
      "description": "If set, enables the auto save system, which periodically saves the condo data after changes have been made",
