      "id": "USERIDREGEX",
      "label": "Player Count Mode",
      "description": "Sets what is considered a player for the player count in GSCS. Bots can be counted as players or not, and players with no GUID can be ignored or counted as players (can cause problems if player changes their name while connected to the server)",
      "tab": "server",
      "section": "Server",
      "type": "enum",
      "default": "(BOT|(?<userid>(?!NOGUID).+?))",
      "placeholder": "",
      "required": false,
      "secret": false,
      "hidden": false,
      "readOnly": false,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {
        "(BOT|(?<userid>(?!NOGUID).+?))": "Count bots as players and ignore players with no GUID (default)",
        "(?<userid>(?!BOT)(?!NOGUID).+?)": "Don't count bots as players and ignore players with no GUID",
        "(NOGUID|BOT|(?<userid>.+?))": "Count bots as players and account for players with no GUID",
        "(NOGUID|(?<userid>(?!BOT).+?))": "Don't count bots as players and account for players with no GUID"
      },
