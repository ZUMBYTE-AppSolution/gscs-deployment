  "deploymentSteps": [
    {
      "name": "SteamCMD Download",
      "type": "steam",
      "phase": "install",
      "platform": "all",
      "source": "632360",
      "target": "1180760",
      "arguments": "public",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "SteamCMD Download",
      "type": "steam",
      "phase": "install",
      "platform": "all",
      "source": "1007",
      "target": "1180760",
      "arguments": "public",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "BepInEx Download",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"BepInExVersion=\\\"{BEPINEXVERSION}\\\" && if [[ -z \\\"$BepInExVersion\\\" ]]; then BepInExVersion=$(wget -qO- https://thunderstore.io/api/v1/package-metrics/bbepis/BepInExPack/ | jq -r \\\".latest_version\\\"); fi && if [[ ! \\\"$BepInExVersion\\\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then echo \\\"Invalid BepInEx version format specified\\\" && exit 1; fi && wget -qO BepInEx.zip https://gcdn.thunderstore.io/live/repository/packages/bbepis-BepInExPack-$BepInExVersion.zip && echo \\\"BepInEx v$BepInExVersion downloaded\\\"\"",
      "conditionVariable": "BEPINEXINSTALL",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "BepInEx Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $BepInExVersion='{BEPINEXVERSION}'; if ([string]::IsNullOrWhiteSpace($BepInExVersion)) { $BepInExVersion=(Invoke-RestMethod -UseBasicParsing -Uri https://thunderstore.io/api/v1/package-metrics/bbepis/BepInExPack/).latest_version }; if ($BepInExVersion -notmatch '^\\d+\\.\\d+\\.\\d+$') { Write-Output \\\"Invalid BepInEx version format specified\\\"; exit 1 }; Invoke-WebRequest -UseBasicParsing -Uri https://gcdn.thunderstore.io/live/repository/packages/bbepis-BepInExPack-$BepInExVersion.zip -OutFile 'BepInEx.zip'; if ($?) { Write-Output \\\"BepInEx v$BepInExVersion downloaded\\\" }\"",
      "conditionVariable": "BEPINEXINSTALL",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "BepInEx Extract",
      "type": "archive",
      "phase": "install",
      "platform": "all",
      "source": "BepInEx.zip",
      "target": "",
      "arguments": "",
      "conditionVariable": "BEPINEXINSTALL",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "BepInEx Copy",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C xcopy /E /Y /I BepInExPack\\*  && rmdir /Q /S BepInExPack",
      "conditionVariable": "BEPINEXINSTALL",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": true
    }
  ],
