      "source": "{\n    \"bbmeta\": \"scnf v0 n1\",\n    \"net server config\": [\n        {\n            \"bbmeta\": \"ncnf v1 n1\",\n            \"name\": \"GSCS Wreckfest 2 Server\",\n            \"description\": \"Welcome to my server!\",\n            \"password\": \"\",\n            \"game port\": 30100\n        }\n    ],\n    \"game server config\": [\n        {\n            \"bbmeta\": \"gcnf v2 n1\",\n            \"event loop name\": \"default_loop\",\n            \"countdown time\": 100000,\n            \"flags\": \"leader enabled\"\n        }\n    ]\n}",
