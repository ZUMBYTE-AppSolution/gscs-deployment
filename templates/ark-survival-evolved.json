{
  "id": "ark-survival-evolved",
  "name": "ARK: Survival Evolved",
  "version": "1.0.0",
  "approved": true,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/ark-survival-evolved.json",
  "sourceRef": "main",
  "steamAppId": 376030,
  "steamGameAppId": 346110,
  "website": "https://store.steampowered.com/app/346110/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs-runtime:0.1.0",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "ShooterGame/Binaries/Win64/ShooterGameServer.exe",
    "linux": "ShooterGame/Binaries/Linux/ShooterGame"
  },
  "arguments": [
    "{MAP}?listen?SessionName={URL_SERVER_NAME}?ServerPassword={SERVER_PASSWORD}?Port={GAME_PORT}?QueryPort={QUERY_PORT}?RCONEnabled=True?RCONPort={RCON_PORT}?MaxPlayers={SLOTS}",
    "-log"
  ],
  "ports": [
    {
      "role": "game",
      "default": 7777,
      "protocol": "udp",
      "containerPort": 7777,
      "offsetFromRole": "",
      "offset": 0
    },
    {
      "role": "peer",
      "default": 7778,
      "protocol": "udp",
      "containerPort": 7778,
      "offsetFromRole": "game",
      "offset": 1
    },
    {
      "role": "query",
      "default": 27015,
      "protocol": "udp",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    },
    {
      "role": "rcon",
      "default": 27020,
      "protocol": "tcp",
      "containerPort": 27020,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "MAP": "TheIsland",
    "SERVER_PASSWORD": "{RANDOM_SECRET}"
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "metadata-validated",
  "warnings": [],
  "licenseUrl": "",
  "attribution": {
    "source": "Valve SteamCMD app_info_print",
    "steamAppId": 376030,
    "checkedAt": "2026-11-02",
    "documentation": "https://developer.valvesoftware.com/wiki/SteamCMD"
  }
}