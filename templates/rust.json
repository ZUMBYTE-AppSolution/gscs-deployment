{
  "id": "rust",
  "name": "Rust · Vanilla",
  "version": "1.1.0",
  "approved": true,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/rust.json",
  "sourceRef": "main",
  "steamAppId": 258550,
  "steamGameAppId": 252490,
  "website": "https://rust.facepunch.com/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs:0.1.0-alpha.2",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "RustDedicated.exe",
    "linux": "RustDedicated"
  },
  "arguments": [
    "-batchmode",
    "-nographics",
    "+server.identity",
    "GSCS",
    "+server.port",
    "{GAME_PORT}",
    "+server.queryport",
    "{QUERY_PORT}",
    "+rcon.port",
    "{RCON_PORT}",
    "+rcon.web",
    "0",
    "+server.maxplayers",
    "{SLOTS}"
  ],
  "ports": [
    {
      "role": "game",
      "default": 28015,
      "protocol": "udp",
      "containerPort": 28015,
      "offsetFromRole": "",
      "offset": 0
    },
    {
      "role": "query",
      "default": 28017,
      "protocol": "udp",
      "containerPort": 28017,
      "offsetFromRole": "",
      "offset": 0
    },
    {
      "role": "rcon",
      "default": 28016,
      "protocol": "tcp",
      "containerPort": 28016,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "RCON_PASSWORD": "{RANDOM_SECRET}"
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "ready",
  "warnings": [],
  "licenseUrl": "",
  "stopCommand": "quit",
  "saveCommand": "server.save",
  "announcementCommand": "say {MESSAGE}",
  "configurationTabs": [
    {
      "id": "security",
      "label": "Sicherheit",
      "order": 0
    },
    {
      "id": "world",
      "label": "Welt",
      "order": 1
    },
    {
      "id": "server",
      "label": "Server",
      "order": 2
    }
  ],
  "configurationFields": [
    {
      "id": "RCON_PASSWORD",
      "label": "RCON-Passwort",
      "default": "{RANDOM_SECRET}",
      "tab": "security",
      "type": "text",
      "secret": true,
      "startupPermission": false
    },
    {
      "id": "WORLD_SEED",
      "label": "Welt-Seed",
      "default": "12345",
      "tab": "world",
      "type": "number"
    },
    {
      "id": "WORLD_SIZE",
      "label": "Weltgröße",
      "default": "3500",
      "tab": "world",
      "type": "number"
    },
    {
      "id": "SAVE_INTERVAL",
      "label": "Speicherintervall in Sekunden",
      "default": "600",
      "tab": "world",
      "type": "number"
    },
    {
      "id": "SERVER_DESCRIPTION",
      "label": "Beschreibung",
      "default": "",
      "tab": "server",
      "type": "text"
    },
    {
      "id": "SERVER_URL",
      "label": "Serverwebsite",
      "default": "",
      "tab": "server",
      "type": "url"
    },
    {
      "id": "SERVER_PVE",
      "label": "PvE",
      "default": "false",
      "tab": "world",
      "type": "checkbox",
      "trueValue": "true",
      "falseValue": "false"
    }
  ],
  "configurationFiles": [
    {
      "path": "server/GSCS/cfg/server.cfg",
      "format": "space",
      "bindings": [
        {
          "key": "server.hostname",
          "variable": "{JSON_SERVER_NAME}",
          "type": "text"
        },
        {
          "key": "rcon.password",
          "variable": "{JSON_RCON_PASSWORD}",
          "type": "text"
        },
        {
          "key": "server.seed",
          "variable": "{WORLD_SEED}",
          "type": "number"
        },
        {
          "key": "server.worldsize",
          "variable": "{WORLD_SIZE}",
          "type": "number"
        },
        {
          "key": "server.saveinterval",
          "variable": "{SAVE_INTERVAL}",
          "type": "number"
        },
        {
          "key": "server.description",
          "variable": "{JSON_SERVER_DESCRIPTION}",
          "type": "text"
        },
        {
          "key": "server.url",
          "variable": "{JSON_SERVER_URL}",
          "type": "text"
        },
        {
          "key": "server.pve",
          "variable": "{SERVER_PVE}",
          "type": "checkbox"
        }
      ]
    }
  ]
}