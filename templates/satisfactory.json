  "deploymentSteps": [
    {
      "name": "SteamCMD Download",
      "type": "steam",
      "phase": "install",
      "platform": "all",
      "source": "1690800",
      "target": "",
      "arguments": "{RELEASESTREAM}",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "SteamCMD Component Download",
      "type": "steam",
      "phase": "install",
      "platform": "windows",
      "source": "1007",
      "target": "FactoryGame/Binaries/Win64",
      "arguments": "public",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Saves Directory Creation",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"mkdir -p ~/.config/Epic/FactoryGame/Saved/SaveGames >/dev/null 2>&1; mkdir -p \\\"{SERVER_DIR}/FactoryGame/Saved\\\" >/dev/null 2>&1; ln -sf ~/.config/Epic/FactoryGame/Saved/SaveGames \\\"{SERVER_DIR}/FactoryGame/Saved/\\\" >/dev/null 2>&1\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Create Readme File",
      "type": "file",
      "phase": "install",
      "platform": "all",
      "source": "WARNING: This directory may include the save data of multiple Satisfactory servers\nrun on this system.\n\nIf viewing this directory from GSCS’s ADS File Manager/SFTP, you will see the\nsave data of all Satisfactory servers run on this system, other than those run by\nGSCS in Docker.\n\nYou will see the same save data if viewing this directory from GSCS’s File Manager/SFTP\nfor a particular Satisfactory instance that is NOT run in Docker.\n\nIf viewing this directory from GSCS’s File Manager/SFTP for a particular Satisfactory\ninstance that IS run in Docker, you will only see the save data of that instance.\n\nYou can also use the ADS File Manager/SFTP to view the save data of a Satisfactory\ninstance that is run in Docker by navigating to the following directory in the\ninstance’s datastore: .virtualhome/.config/Epic/FactoryGame/Saved/SaveGames.\n\nThe save data for a specific instance is linked to its port (as part of the\nServerSettings file name) and its session name (as part of the autosave file names\nin the server subdirectory).\n\nSave data will not be automatically deleted when a non-Docker Satisfactory server is\nremoved, so you may need to delete the ServerSettings file and/or autosave files\nif later creating a new Satisfactory server with the same port and/or session name.\n\nTake care when managing files in this directory or its subdirectory!",
      "target": "FactoryGame/Saved/SaveGames/README.txt",
      "arguments": "{SERVER_DIR}/FactoryGame/Saved/SaveGames/README.txt",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": true,
      "preserveExisting": false
    }
  ],
