    {
      "name": "Disable Prefix Sound",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"cd . && export PATH=\\\"{SERVER_DIR}/.proton/files/bin:$PATH\\\"; export WINEPREFIX=\\\"{SERVER_DIR}/.proton/compatdata/pfx\\\"; export WINEARCH=win64; ./.proton/protonfixes/winetricks sound=disabled > winescript_log.txt 2>&1\"",
