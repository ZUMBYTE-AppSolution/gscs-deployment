  "deploymentSteps": [
    {
      "name": "Bot Download",
      "type": "download-extract",
      "phase": "install",
      "platform": "all",
      "source": "https://github.com/k8thekat/GatekeeperV2/archive/refs/heads/main.zip",
      "target": "",
      "arguments": "",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Create Virtual Environment",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"/usr/bin/python{PYTHONVERSION} -m venv --clear --upgrade-deps \\\"{SERVER_DIR}/venv\\\"\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Create Virtual Environment",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C py -{PYTHONVERSION} -m venv --clear --upgrade-deps \"{SERVER_DIR}/venv\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Install Basic Python Packages",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"source \\\"{SERVER_DIR}/venv/bin/activate\\\" && python3 -m pip install -U setuptools wheel\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Install Basic Python Packages",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C \"{SERVER_DIR}/venv\\Scripts\\activate.bat\" && python.exe -m pip install -U setuptools wheel",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    }
  ],
