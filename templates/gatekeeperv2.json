      "section": "Bot",
      "type": "enum",
      "default": "3",
      "placeholder": "",
      "required": false,
      "secret": false,
      "hidden": false,
      "readOnly": false,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {
        "3": "System default",
        "3.8": "3.8",
        "3.9": "3.9",
        "3.10": "3.10",
        "3.11": "3.11"
