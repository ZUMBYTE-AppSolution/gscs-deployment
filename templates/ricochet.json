{
  "id": "ricochet",
  "name": "Ricochet",
  "version": "1.1.0",
  "approved": true,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/ricochet.json",
  "sourceRef": "main",
  "steamAppId": 90,
  "steamGameAppId": 60,
  "website": "https://store.steampowered.com/app/60/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs:0.1.0-alpha.2",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "hlds.exe",
    "linux": "hlds_run"
  },
  "arguments": [
    "-console",
    "-game",
    "ricochet",
    "-port",
    "{GAME_PORT}",
    "+maxplayers",
    "{SLOTS}",
    "+map",
    "{MAP}"
  ],
  "ports": [
    {
      "role": "game",
      "default": 27015,
      "protocol": "both",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "MAP": "rc_arena",
    "STEAM_MOD": "ricochet",
    "RCON_PASSWORD": "{RANDOM_SECRET}"
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "ready",
  "warnings": [],
  "licenseUrl": "",
  "textConfigs": {
    "ricochet/server.cfg": "hostname {JSON_SERVER_NAME}\nrcon_password {JSON_RCON_PASSWORD}\n"
  },
  "stopCommand": "quit",
  "attribution": {
    "source": "Valve SteamCMD app_info_print",
    "steamAppId": 90,
    "checkedAt": "2026-11-02",
    "documentation": "https://developer.valvesoftware.com/wiki/SteamCMD"
  },
  "configurationTabs": [
    {
      "id": "runtime",
      "label": "Laufzeit",
      "order": 0
    },
    {
      "id": "security",
      "label": "Sicherheit",
      "order": 1
    }
  ],
  "configurationFields": [
    {
      "id": "MAP",
      "label": "Map",
      "default": "rc_arena",
      "tab": "runtime",
      "type": "text",
      "secret": false,
      "startupPermission": false
    },
    {
      "id": "STEAM_MOD",
      "label": "Steam Mod",
      "default": "ricochet",
      "tab": "runtime",
      "type": "text",
      "secret": false,
      "startupPermission": false
    },
    {
      "id": "RCON_PASSWORD",
      "label": "RCON-Passwort",
      "default": "{RANDOM_SECRET}",
      "tab": "security",
      "type": "text",
      "secret": true,
      "startupPermission": false
    }
  ],
  "configurationFiles": []
}