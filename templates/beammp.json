    {
      "name": "Binary and Symlink Removal",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"rm {SERVER_DIR}/BeamMP-Server* >/dev/null 2>&1\"",
      "conditionVariable": "",
      "conditionValue": "",
