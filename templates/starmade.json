  "deploymentSteps": [
    {
      "name": "StarMade Download (Linux)",
      "type": "archive",
      "phase": "install",
      "platform": "linux",
      "source": "starmade-latest.zip",
      "target": "",
      "arguments": "0",
      "conditionVariable": "",
