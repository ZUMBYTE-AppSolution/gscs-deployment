  "configurationFiles": [
    {
      "path": "server-data/server.cfg",
      "format": "template",
      "lineFormat": "",
      "bindings": [],
      "template": "# This file is controlled by GSCS. Any manual changes will be overwritten\n# If you need to add any extra settings, add them through the GSCS UI\n\nendpoint_add_tcp \"{GAME_BIND}:{GAME_PORT}\"\nendpoint_add_udp \"{GAME_BIND}:{GAME_PORT}\"\nsv_licenseKey {JSON_SV_LICENSEKEY}\nset steam_webApiKey {JSON_STEAM_WEBAPIKEY}\nsv_enforceGameBuild {SV_ENFORCEGAMEBUILD}\nsv_maxClients {SLOTS}\n\n{SV_PURELEVEL}\nsv_requestParanoia {SV_REQUESTPARANOIA}\n{SV_MASTER1}\nsv_endpointPrivacy {SV_ENDPOINTPRIVACY}\n\nset onesync {ONESYNC}\nset onesync_population {ONESYNC_POPULATION}\nset onesync_distanceCullVehicles {ONESYNC_DISTANCECULLVEHICLES}\nset onesync_forceMigration {ONESYNC_FORCEMIGRATION}\nset onesync_workaround763185 {ONESYNC_WORKAROUND763185}\nsv_scriptHookAllowed {SV_SCRIPTHOOKALLOWED}\n\n{USERSETTINGS}\n\n{ACCESSCONTROLCOMMANDS}\n\n{ENSURE}",
      "onlyIfPresent": false,
      "onlyExistingBindings": false,
      "platform": "all"
    }
  ],
