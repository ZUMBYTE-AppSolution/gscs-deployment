{
  "id": "hytale",
  "name": "Hytale",
  "version": "1.1.0",
  "approved": true,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/hytale.json",
  "sourceRef": "main",
  "steamAppId": null,
  "steamGameAppId": null,
  "website": "https://hytale.com/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs-runtime:0.1.0",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "java",
    "linux": "java"
  },
  "arguments": [
    "-Xms1G",
    "-Xmx{MEMORY}M",
    "-Dterminal.jline=false",
    "-jar",
    "HytaleServer.jar",
    "--assets",
    "../Assets.zip",
    "--bind",
    "0.0.0.0:{GAME_PORT}",
    "--auth-mode",
    "authenticated"
  ],
  "ports": [
    {
      "role": "game",
      "default": 5520,
      "protocol": "udp",
      "containerPort": 5520,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "JAVA_MAJOR": "25",
    "HYTALE_PATCHLINE": "release"
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "hytale",
  "validationStatus": "metadata-validated",
  "warnings": [
    "Vor dem ersten Start unter Hytale-Anmeldung ein Konto verbinden und ein Spielprofil auswählen. Die Erneuerung erfolgt automatisch.",
    "Der offizielle Downloader benötigt eine separate Geräteanmeldung. Java 25 und UDP/QUIC sind erforderlich.",
    "Der Downloader ist für x64 verfügbar. Auf ARM64 Original-Serverdateien manuell bereitstellen."
  ],
  "licenseUrl": "https://www.hytale.com/legal/terms-of-service",
  "workingDirectory": "Server",
  "stopCommand": "stop",
  "saveCommand": "save",
  "authentication": "hytale"
}