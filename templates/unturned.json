    },
    {
      "role": "game",
      "default": 27016,
      "protocol": "udp",
      "containerPort": 27016,
      "offsetFromRole": "query",
      "offset": 1
    }
  ],
  "defaults": {
    "GSLT_TOKEN": ""
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "metadata-validated",
  "warnings": [
    "Official ServerHelper entrypoints and linked query/game pair: https://docs.smartlydressedgames.com/en/stable/servers/steamcmd.html",
