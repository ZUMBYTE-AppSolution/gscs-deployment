    "No live game launch has been performed."
  ],
  "licenseUrl": "",
  "platformArguments": {
    "windows": [
      "/d",
      "/c",
      "ServerHelper.bat",
      "+InternetServer/GSCS"
    ],
    "linux": [
      "+InternetServer/GSCS"
    ]
  },
  "textConfigs": {
    "Servers/GSCS/Server/Commands.dat": "Name {SERVER_NAME}\nPort {QUERY_PORT}\nMaxPlayers {SLOTS}\n"
  },
  "stopCommand": "Shutdown",
  "saveCommand": "Save"
