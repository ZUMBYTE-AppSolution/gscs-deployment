  "deploymentSteps": [
    {
      "name": "RAGE:MP Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; cd .; $baseURL = 'https://cdn.rage.mp/updater/prerelease_server/'; $xmlURL = 'https://cdn.rage.mp/updater/prerelease_server/data.xml?item=All'; [xml]$data = (New-Object System.Net.WebClient).DownloadString($xmlURL); foreach ($file in $data.SelectNodes('//file[contains(text(), \\\"server-files\\\")]')) { $filePath = $file.InnerText; if ($filePath -eq 'server-files\\linux_x64.tar.gz') { continue }; $downloadURL = $baseURL + ($filePath -replace '\\\\', '/'); $localFilePath = Join-Path -Path $PWD -ChildPath $filePath; $localDir = [System.IO.Path]::GetDirectoryName($localFilePath); if (-not (Test-Path -Path $localDir)) { New-Item -ItemType Directory -Path $localDir -Force | Out-Null }; Invoke-WebRequest -Uri $downloadURL -OutFile $localFilePath | Out-Null }\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "RAGE:MP Download",
      "type": "archive",
      "phase": "install",
      "platform": "linux",
      "source": "linux_x64.tar.gz",
      "target": "",
