    {
      "name": ".NET SDK Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Set-Location -Path '{SERVER_DIR}/'; if (Test-Path 'dotnet-sdk/dotnet.exe') { Write-Output \\\".NET SDK 3.1.201 already installed. Skipping\\\"; exit 0 } else { if ( Test-Path dotnet.zip ) { Remove-Item dotnet.zip -Force -ErrorAction SilentlyContinue *> $null }; try { Invoke-WebRequest -UseBasicParsing -Uri https://builds.dotnet.microsoft.com/dotnet/Sdk/3.1.201/dotnet-sdk-3.1.201-win-x64.zip -OutFile dotnet.zip -ErrorAction Stop } catch { Write-Output \\\"Download failed from the Microsoft CDN. This is a fault with the CDN, not GSCS. Aborting\\\"; exit 1; }; Remove-Item -Path 'dotnet-sdk/*' -Recurse -Force -ErrorAction SilentlyContinue; Expand-Archive -Path \\\"dotnet.zip\\\" -DestinationPath \\\"dotnet-sdk\\\" -Force *> $null; if ( Test-Path dotnet.zip ) { Remove-Item dotnet.zip -Force -ErrorAction SilentlyContinue *> $null }; Write-Output \\\".NET SDK 3.1.201 (for .NET Runtime 3.1.3) downloaded\\\" }\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    }
