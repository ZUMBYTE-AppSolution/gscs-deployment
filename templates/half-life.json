{
  "id": "half-life",
  "name": "Half-Life Deathmatch",
  "version": "1.0.0",
  "approved": true,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/half-life.json",
  "sourceRef": "main",
  "steamAppId": 90,
  "steamGameAppId": 70,
  "website": "https://store.steampowered.com/app/70/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs-runtime:0.1.0",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "hlds.exe",
    "linux": "hlds_run"
  },
  "arguments": [
    "-console",
    "-game",
    "valve",
    "-port",
    "{GAME_PORT}",
    "+maxplayers",
    "{SLOTS}",
    "+map",
    "{MAP}"
  ],
  "ports": [
    {
      "role": "game",
      "default": 27015,
      "protocol": "both",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {
    "MAP": "crossfire",
    "STEAM_MOD": "valve",
    "RCON_PASSWORD": "{RANDOM_SECRET}"
  },
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "metadata-validated",
  "warnings": [],
  "licenseUrl": "",
  "textConfigs": {
    "valve/server.cfg": "hostname {JSON_SERVER_NAME}\nrcon_password {JSON_RCON_PASSWORD}\n"
  },
  "stopCommand": "quit",
  "attribution": {
    "source": "Valve SteamCMD app_info_print",
    "steamAppId": 90,
    "checkedAt": "2026-11-02",
    "documentation": "https://developer.valvesoftware.com/wiki/SteamCMD"
  }
}