{
  "id": "conan-exiles",
  "name": "Conan Exiles",
  "version": "1.0.0",
  "approved": false,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/conan-exiles.json",
  "sourceRef": "main",
  "steamAppId": 443030,
  "steamGameAppId": 440900,
  "website": "https://store.steampowered.com/app/440900/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs-runtime:0.1.0",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "ConanSandboxServer.exe",
    "linux": "ConanSandbox/Binaries/Linux/ConanSandboxServer"
  },
  "arguments": [
    "-log",
    "-Port={GAME_PORT}",
    "-QueryPort={QUERY_PORT}"
  ],
  "ports": [
    {
      "role": "game",
      "default": 7777,
      "protocol": "udp",
      "containerPort": 7777,
      "offsetFromRole": "",
      "offset": 0
    },
    {
      "role": "peer",
      "default": 7778,
      "protocol": "udp",
      "containerPort": 7778,
      "offsetFromRole": "game",
      "offset": 1
    },
    {
      "role": "query",
      "default": 27015,
      "protocol": "udp",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {},
  "installScripts": {},
  "updateScripts": {},
  "query": "source",
  "validationStatus": "configuration-required",
  "warnings": [
    "Vor der Freigabe die mitgelieferte Spielkonfiguration, Zugangsdaten und Startparameter prüfen."
  ],
  "licenseUrl": "",
