    {
      "name": "OpenRA Tiberian Dawn Download",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"cd openra/appimage && CURRENT_VERSION=$(wget -qO- https://www.openra.net/versions.json | jq -r \\\".release\\\") && wget -qO OpenRA.AppImage \\\"https://github.com/OpenRA/OpenRA/releases/download/${CURRENT_VERSION}/OpenRA-Tiberian-Dawn-x86_64.AppImage\\\" && echo \\\"OpenRA version $CURRENT_VERSION downloaded\\\"\"",
      "conditionVariable": "SERVERBUILD",
      "conditionValue": "release",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "OpenRA Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; $CURRENT_VERSION=(Invoke-RestMethod -UseBasicParsing -Uri 'https://www.openra.net/versions.json').release; Invoke-WebRequest -UseBasicParsing -Uri \\\"https://github.com/OpenRA/OpenRA/releases/download/${CURRENT_VERSION}/OpenRA-${CURRENT_VERSION}-x64-winportable.zip\\\" -OutFile 'OpenRA.zip'; if ($?) { Write-Output \\\"OpenRA version $CURRENT_VERSION downloaded\\\" }\"",
      "conditionVariable": "SERVERBUILD",
      "conditionValue": "release",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "OpenRA Tiberian Dawn Download",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"cd openra/appimage && CURRENT_VERSION=$(wget -qO- https://www.openra.net/versions.json | jq -r \\\".playtest\\\") && wget -qO OpenRA.AppImage \\\"https://github.com/OpenRA/OpenRA/releases/download/${CURRENT_VERSION}/OpenRA-Tiberian-Dawn-playtest-x86_64.AppImage\\\" && echo \\\"OpenRA version $CURRENT_VERSION downloaded\\\"\"",
      "conditionVariable": "SERVERBUILD",
      "conditionValue": "playtest",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "OpenRA Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
