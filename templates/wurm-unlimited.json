  "deploymentSteps": [
    {
      "name": "SteamCMD Download",
      "type": "steam",
      "phase": "install",
      "platform": "all",
      "source": "402370",
      "target": "",
      "arguments": "public",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Download Wurm Server Mod Launcher",
      "type": "json-download-extract",
      "phase": "install",
      "platform": "all",
      "source": "https://api.github.com/repos/ago1024/WurmServerModLauncher/releases/latest",
      "target": "",
      "arguments": "$.assets[?(@.name =~ /^server-modlauncher-.*\\.zip$/)].browser_download_url",
      "conditionVariable": "MODLAUNCHER",
      "conditionValue": "-patched",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Patch Server Launcher",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C cd /d 402370 && (patcher.bat < NUL) & if not exist WurmServerLauncher-patched.exe exit /b 1",
      "conditionVariable": "MODLAUNCHER",
      "conditionValue": "-patched",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Patch Server Launcher",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"cd ./402370 && chmod +x patcher.sh && ./patcher.sh; chmod +x WurmServerLauncher-patched 2>/dev/null; test -f WurmServerLauncher-patched\"",
      "conditionVariable": "MODLAUNCHER",
      "conditionValue": "-patched",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Download Announcer Mod",
      "type": "json-download-extract",
      "phase": "install",
      "platform": "all",
      "source": "https://api.github.com/repos/ago1024/WurmServerModLauncher/releases/latest",
      "target": "",
      "arguments": "$.assets[?(@.name =~ /^announcer-.*\\.zip$/)].browser_download_url",
      "conditionVariable": "ANNOUNCER",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": false
    },
