  "configurationFiles": [
    {
      "path": "userdata/server/server_config/settings.ron",
      "format": "template",
      "lineFormat": "",
      "bindings": [],
      "template": "// DO NOT edit settings.ron directly\n// AMP_settings.ron controls settings.ron. Edit AMP_settings.ron if you want to add or change certain settings\n// NOTE:\n// - Do not change values in double curly braces, ie {{}}. They are set either via the GSCS UI (under \"Server Settings\")\n//   or are controlled by GSCS itself (in particular, ports)\n// - Other settings can be changed or added as needed\n(\n    gameserver_protocols: [\n        Tcp(\n            address: \"0.0.0.0:{GAME_PORT}\",\n        ),\n        // Uncomment the block below if you want the server to bind on an IPv6 socket as well as IPv4\n        /*\n        Tcp(\n            address: \"[::]:{GAME_PORT}\",\n        ),\n        */\n    ],\n    metrics_address: \"127.0.0.1:{METRICS_PORT}\",\n    auth_server_address: Some(\"https://auth.veloren.net\"),\n    max_players: {SLOTS},\n    world_seed: 230,\n    server_name: {JSON_SERVER_NAME},\n    start_time: 32400,\n    map_file: None,\n    max_view_distance: Some(65),\n    banned_words_files: [],\n    max_player_group_size: 6,\n    client_timeout: (\n        secs: 40,\n        nanos: 0,\n    ),\n    spawn_town: None,\n    max_player_for_kill_broadcast: None,\n    calendar_mode: Auto,\n    gameplay: (\n        battle_mode: Global(PvP),\n        safe_spawn: false,\n        explosion_burn_marks: true,\n    ),\n)",
      "onlyIfPresent": false,
      "onlyExistingBindings": false,
      "platform": "all"
    }
  ],
  "deploymentSteps": [
    {
      "name": "Server Download",
      "type": "download-extract",
      "phase": "install",
      "platform": "windows",
      "source": "https://download.veloren.net/latest/windows/x86_64/{RELEASEVERSION}",
      "target": "",
      "arguments": "{RELEASEVERSION}.zip",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Server Download",
      "type": "download-extract",
      "phase": "install",
      "platform": "linux",
      "source": "https://download.veloren.net/latest/linux/x86_64/{RELEASEVERSION}",
      "target": "",
      "arguments": "{RELEASEVERSION}.zip",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Set Executable Flag",
      "type": "executable",
      "phase": "install",
      "platform": "linux",
      "source": "",
      "target": "veloren-server-cli",
      "arguments": "{SERVER_DIR}/veloren-server-cli",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Config Directory Creation",
      "type": "directory",
      "phase": "install",
      "platform": "all",
      "source": "",
      "target": "userdata/server/server_config",
      "arguments": "{SERVER_DIR}/userdata/server/server_config",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    }
  ],
