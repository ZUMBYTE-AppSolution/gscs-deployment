  "deploymentSteps": [
    {
      "name": "App Download",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; cd .; Remove-Item srv -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; $DownloadSource = \\\"{DOWNLOADSOURCE}\\\"; $DownloadBranch = \\\"{DOWNLOADBRANCH}\\\"; if (![string]::IsNullOrEmpty(\\\"{DOWNLOADUSERNAME}\\\")) { $DownloadUrl = $DownloadSource -replace \\\"https://\\\", \\\"https://{DOWNLOADUSERNAME}:{DOWNLOADPASSWORD}@\\\" } else { $DownloadUrl = \\\"$DownloadSource\\\" }; if (-Not (Test-Path .git)) { Write-Output \\\"Installing the app\\\"; git clone \\\"$DownloadUrl\\\" srv 1> $null; Copy-Item srv/* ./ -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; Remove-Item srv -Recurse -Force -ErrorAction SilentlyContinue | Out-Null; if ([string]::IsNullOrEmpty($DownloadBranch)) { $DownloadBranch = (git symbolic-ref refs/remotes/origin/HEAD) -replace '.*/' }; git checkout --force $DownloadBranch 1> $null; if ($LASTEXITCODE -eq 0) { git pull 1> $null }; if ($LASTEXITCODE -eq 0) { Write-Output \\\"App installed\\\" } } else { Write-Output \\\"Updating the app\\\"; git remote set-url origin \\\"$DownloadUrl\\\" 1> $null; if ([string]::IsNullOrEmpty($DownloadBranch)) { $DownloadBranch = (git symbolic-ref refs/remotes/origin/HEAD) -replace '.*/' }; git checkout --force $DownloadBranch 1> $null; if ($LASTEXITCODE -eq 0) { git pull 1> $null }; if ($LASTEXITCODE -eq 0) { Write-Output \\\"App updated\\\" } }\"",
      "conditionVariable": "DOWNLOADTYPE",
      "conditionValue": "GitRepo",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "App Download",
      "type": "github-extract",
      "phase": "install",
      "platform": "all",
      "source": "{{DownloadSource}}",
      "target": "",
      "arguments": "{{DownloadFilename}}",
      "conditionVariable": "DOWNLOADTYPE",
      "conditionValue": "GithubRelease",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "App Download",
      "type": "download-extract",
      "phase": "install",
      "platform": "all",
      "source": "{DOWNLOADSOURCE}",
      "target": "",
      "arguments": "",
      "conditionVariable": "DOWNLOADTYPE",
      "conditionValue": "DownloadURL",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Create Virtual Environment",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"if ! command -v /usr/bin/python{PYTHONVERSION} >/dev/null 2>&1; then echo 'Error: Python {PYTHONVERSION} is not installed.\nSee  exit 1; fi; /usr/bin/python{PYTHONVERSION} -u -m venv --clear --upgrade-deps \\\"{SERVER_DIR}/venv\\\"\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Create Virtual Environment",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C where py >NUL 2>&1 || (echo Error: Python launcher \"py\" is not installed for all users on this system or is not in the System PATH. & echo See  & exit /b 1) & py -{PYTHONVERSION} --version >NUL 2>&1 || (echo Error: Python {PYTHONVERSION} is not installed for all users on this system. & echo See  & exit /b 1) & py -{PYTHONVERSION} -u -m venv --clear --upgrade-deps \"{SERVER_DIR}/venv\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Install Basic Python Packages",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"source \\\"{SERVER_DIR}/venv/bin/activate\\\" && python3 -u -m pip install -U setuptools wheel discord.py python-dotenv\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Install Basic Python Packages",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
      "target": "",
      "arguments": "/C \"{SERVER_DIR}/venv\\Scripts\\activate.bat\" && python.exe -u -m pip install -U setuptools wheel discord.py python-dotenv",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "App Download",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"source \\\"{SERVER_DIR}/venv/bin/activate\\\" && python3 -u -m pip install -U {DOWNLOADPACKAGEARGS} {DOWNLOADSOURCE}\"",
      "conditionVariable": "DOWNLOADTYPE",
      "conditionValue": "PyPIPackage",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "App Download",
