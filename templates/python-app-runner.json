      "conditionVariable": "RUNAPPSETUPCOMMAND",
      "conditionValue": "true",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Run App Setup Command",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "cmd.exe",
