      "secret": false,
      "hidden": false,
      "readOnly": false,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {
        "": "--Please select--",
        "DownloadURL": "Download URL",
        "GithubRelease": "GitHub release",
        "GitRepo": "Git repo",
        "PyPIPackage": "PyPI package",
