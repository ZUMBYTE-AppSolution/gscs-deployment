      "section": "Server",
      "type": "text",
      "default": "TeaSpeak\\n\\rWelcome to the TeaSpeak ServerQuery interface.\\n\\r",
      "placeholder": "TeaSpeak\\n\\rWelcome to the TeaSpeak ServerQuery interface.\\n\\r",
      "required": false,
      "secret": false,
      "hidden": false,
      "readOnly": false,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {},
      "trueValue": "true",
      "falseValue": "false",
      "parameter": "motd",
      "parameterFormat": "--property:{0}={1}",
      "includeInArguments": false,
      "isFlag": false,
      "skipIfEmpty": true
    },
    {
      "id": "ENABLESSL",
      "label": "Query SSL Mode",
      "description": "Sets the server query SSL mode",
      "tab": "server",
      "section": "Server",
      "type": "enum",
      "default": "2",
      "placeholder": "",
      "required": false,
      "secret": false,
      "hidden": false,
      "readOnly": false,
      "startupPermission": false,
      "argumentFragment": false,
      "options": {
        "0": "SSL disabled",
        "1": "SSL enabled (enforced encryption)",
        "2": "Prefer encryption but fallback when not available (default)"
      },
      "trueValue": "true",
      "falseValue": "false",
      "parameter": "query.enableSSL",
      "parameterFormat": "--property:{0}={1}",
      "includeInArguments": true,
      "isFlag": false,
      "skipIfEmpty": true
    }
  ],
