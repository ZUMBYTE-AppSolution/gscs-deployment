      "target": "",
      "arguments": "",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Create yt-dlp Directory",
      "type": "directory",
      "phase": "install",
      "platform": "linux",
