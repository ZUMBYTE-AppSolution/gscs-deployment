    {
      "name": "Server Installation",
      "type": "command",
      "phase": "install",
      "platform": "windows",
      "source": "powershell.exe",
      "target": "",
      "arguments": "-NoProfile -Command \"$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Set-Location -Path 'sauerbraten'; Write-Output \\\"Installing/updating server\\\"; Invoke-WebRequest -UseBasicParsing -UserAgent \\\"Wget/1.21.4\\\" -Uri 'https://sourceforge.net/projects/sauerbraten/files/latest/download' -OutFile 'sauerbraten.exe'; if ($?) { & './sauerbraten.exe' /S \\\"/D={SERVER_DIR}/\\\\\" *> $null; if ($LASTEXITCODE -eq 0) { Write-Output \\\"Server installed/updated\\\"; Remove-Item -Path 'sauerbraten.exe' -Force -ErrorAction SilentlyContinue | Out-Null } }\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
