  "deploymentSteps": [
    {
      "name": "SteamCMD Server Download",
      "type": "steam",
      "phase": "install",
      "platform": "all",
      "source": "2058450",
      "target": "",
      "arguments": "{SERVERBRANCH}",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Initialise Wine",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "-c \"WINEPREFIX=\\\"{SERVER_DIR}/.wine\\\" WINEARCH=win64 WINEDEBUG=-all /usr/bin/wineboot --init --update\"",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    },
    {
      "name": "Winescript Download",
      "type": "file",
      "phase": "install",
      "platform": "linux",
      "source": "#!/bin/bash\n\nSCRIPT_NAME=$(echo \\\"$0\\\" | xargs readlink -f)\nSCRIPTDIR=$(dirname \"$SCRIPT_NAME\")\n\nexec 6>display.log\n/usr/bin/Xvfb -displayfd 6 -nolisten tcp -nolisten unix &\nXVFB_PID=$!\nwhile [[ ! -s display.log ]]; do\n  sleep 1\ndone\nread -r DPY_NUM < display.log\nrm display.log\n\nexport WINEPREFIX=\"$SCRIPTDIR/swords-n-magic-and-stuff/.wine\"\nexport WINEDLLOVERRIDES=\"mscoree,mshtml=\"\nexport WINEARCH=win64\nexport WINEDEBUG=fixme-all\nexport DISPLAY=:$DPY_NUM\n\n[[ -f winetricks ]] && rm -f winetricks\nwget -q https://raw.githubusercontent.com/Winetricks/winetricks/refs/tags/20260125/src/winetricks\nchmod +x winetricks\n\nPACKAGES=\"vcrun2022\"\necho \"\" > winescript_log.txt 2>&1\nfor PACKAGE in $PACKAGES; do\n  ./winetricks -q $PACKAGE >> winescript_log.txt 2>&1\ndone\nrm -rf ~/.cache/winetricks\n\nexec 6>&-\nkill $XVFB_PID\n\nexit 0",
      "target": "{{$FullInstanceDir}}/winescript.sh",
      "arguments": "winescript.sh",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": false
    },
    {
      "name": "Install Windows Components",
      "type": "command",
      "phase": "install",
      "platform": "linux",
      "source": "/bin/bash",
      "target": "",
      "arguments": "./winescript.sh",
      "conditionVariable": "",
      "conditionValue": "",
      "optional": false,
      "preserveExisting": true
    }
