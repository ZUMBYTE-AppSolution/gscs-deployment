{
  "id": "core-keeper",
  "name": "Core Keeper",
  "version": "1.0.0",
  "approved": false,
  "sourceUrl": "https://raw.githubusercontent.com/ZUMBYTE-AppSolution/gscs-deployment/main/templates/core-keeper.json",
  "sourceRef": "main",
  "steamAppId": 1963720,
  "steamGameAppId": 1621690,
  "website": "https://store.steampowered.com/app/1621690/",
  "windowsOnly": false,
  "image": "ghcr.io/zumbyte-appsolution/gscs-runtime:0.1.0",
  "operatingSystems": [
    "windows",
    "linux"
  ],
  "executables": {
    "windows": "CoreKeeperServer.exe",
    "linux": "CoreKeeperServer"
  },
  "arguments": [
    "-batchmode",
    "-nographics",
    "-port",
    "{GAME_PORT}",
    "-worldname",
    "{SERVER_NAME}",
    "-maxplayers",
    "{SLOTS}",
    "-datapath",
    "{SERVER_DIR}/Saves"
  ],
  "ports": [
    {
      "role": "game",
      "default": 27015,
      "protocol": "udp",
      "containerPort": 27015,
      "offsetFromRole": "",
      "offset": 0
    }
  ],
  "defaults": {},
  "installScripts": {},
  "updateScripts": {},
  "query": "none",
  "validationStatus": "configuration-required",
  "warnings": [
    "Vor der Freigabe die mitgelieferte Spielkonfiguration, Zugangsdaten und Startparameter prüfen."
  ],
  "licenseUrl": "",
  "attribution": {
    "source": "Valve SteamCMD app_info_print",
    "steamAppId": 1963720,
    "checkedAt": "2026-11-02",
    "documentation": "https://developer.valvesoftware.com/wiki/SteamCMD"
  }
}